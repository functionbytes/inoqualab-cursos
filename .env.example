# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
APP_NAME=Training
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://training.test
APP_LOCALE=es
APP_TIMEZONE=America/Bogota

# En producción: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=error

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────
# Database (conexión principal MySQL)
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=training
DB_USERNAME=root
DB_PASSWORD=

# Segunda conexión (Oracle/MySQL legacy — GESTCENT)
DB_HOST_SECOND=
DB_PORT_SECOND=
DB_DATABASE_SECOND=
DB_USERNAME_SECOND=
DB_PASSWORD_SECOND=

# ─────────────────────────────────────────────────────────────
# Cache / Sessions / Queue
# ─────────────────────────────────────────────────────────────
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
MEMCACHED_HOST=127.0.0.1

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE=default

# ─────────────────────────────────────────────────────────────
# Broadcasting (Pusher / Reverb)
# ─────────────────────────────────────────────────────────────
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ─────────────────────────────────────────────────────────────
# Mail (SMTP / Mailjet)
# ─────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@training.test
MAIL_FROM_NAME="${APP_NAME}"
MAILJET_APIKEY=
MAILJET_APISECRET=

# ─────────────────────────────────────────────────────────────
# AWS S3 (Media Library)
# ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────────────────────────
# IMAP (Correos entrantes → órdenes/matrículas)
# ─────────────────────────────────────────────────────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_DEFAULT_ACCOUNT=default
INCOMING_MAIL_ENABLED=false
INCOMING_MAIL_AUTO_PROCESS=false
INCOMING_MAIL_FOLDER=INBOX
INCOMING_MAIL_CONFIDENCE_THRESHOLD=0.7
INCOMING_MAIL_TRUSTED_SENDERS=
INCOMING_MAIL_TRUST_ALL_SENDERS=false

# ─────────────────────────────────────────────────────────────
# Pagos — Wompi
# Nota: las claves de Wompi se gestionan en Settings (BD) vía setting('wompi_*').
# config/services.php provee fallback por env si se prefiere:
# ─────────────────────────────────────────────────────────────
# WOMPI_PUBLIC_KEY=
# WOMPI_INTEGRITY_SECRET=
# WOMPI_EVENTS_SECRET=
# WOMPI_SANDBOX=true

# ─────────────────────────────────────────────────────────────
# Google Analytics (Spatie)
# Credenciales en: storage/app/analytics/service-account-credentials.json
# (NO versionar — provisto vía secrets de deploy)
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Error tracking en producción (opcional)
# ─────────────────────────────────────────────────────────────
# FLARE_KEY=
